{
  "name": "payflow-payment-page",
  "version": "1.0.0",
  "private": true,
  "description": "A polished fintech checkout experience built with React, Vite, Tailwind CSS, and Framer Motion.",
  "license": "MIT",
  "packageManager": "npm@10.9.7",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "concurrently \"node mock-server.js\" \"vite\"",
    "mock": "node mock-server.js",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:docker": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=json --outputFile=coverage/vitest-report.json",
    "test:coverage:sonar": "vitest run --coverage --coverage.reporter=json --coverage.reporter=text --coverage.reporter=lcov --outputFile=coverage/vitest-report.json",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test tests/e2e/specs/fullstack-checkout.spec.ts --config=playwright.local.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report test-results/html",
    "generate:api": "openapi-generator-cli generate",
    "generate:api:auth": "openapi-generator-cli generate -i http://localhost:8082/api-docs -g typescript-axios -o src/api/auth",
    "generate:api:payment": "openapi-generator-cli generate -i http://localhost:8083/api-docs -g typescript-axios -o src/api/payment",
    "generate:api:all": "npm run generate:api:auth && npm run generate:api:payment"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.62.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.14.0",
    "express": "^4.18.2",
    "framer-motion": "^12.42.0",
    "jspdf": "^2.5.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "24.1.3",
    "postcss": "^8.4.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
